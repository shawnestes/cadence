# ── Cadence ESP — environment variable reference ────────────────────────────────
# Copy to .env and fill in real values before running docker compose.
# Lines marked "# SECRET" must never be committed to version control.

# ── Core ────────────────────────────────────────────────────────────────────────

# SQLAlchemy async DSN for Aurora Postgres
# Format: postgresql+asyncpg://user:password@host:5432/dbname
CADENCE_DATABASE_URL=postgresql+asyncpg://cadence:changeme@db.example.com:5432/cadence  # SECRET — do not commit

# Static API key used by callers of protected /api/* routes
CADENCE_API_KEY=changeme-api-key  # SECRET — do not commit

# Application environment: dev | staging | production
CADENCE_ENVIRONMENT=production

# Log verbosity: DEBUG | INFO | WARNING | ERROR
CADENCE_LOG_LEVEL=INFO

# Human-readable name shown in FastAPI docs / structlog
CADENCE_APP_NAME=cadence

# ── Unsubscribe / compliance ─────────────────────────────────────────────────────

# Secret used to sign one-click unsubscribe tokens (itsdangerous)
CADENCE_UNSUB_SIGNING_KEY=changeme-unsub-signing-key  # SECRET — do not commit

# Public base URL of this deployment — used to build unsub links in outgoing emails
CADENCE_UNSUB_BASE_URL=https://mail.example.com

# ── AWS / SES ────────────────────────────────────────────────────────────────────

# Use "ses" in production; "noop" for local testing without real sends
CADENCE_ESP_BACKEND=ses

CADENCE_AWS_REGION=us-east-1

# SES configuration set name (routes events to SNS)
CADENCE_SES_CONFIGURATION_SET=cadence-events

# Verified sending domain in SES (used for DKIM and List-Unsubscribe headers)
CADENCE_SES_SENDING_DOMAIN=mail.example.com

# Default From address; must be verified (or domain-verified) in SES
CADENCE_SES_FROM_ADDRESS=Cadence <noreply@mail.example.com>

# Optional: dedicated IP pool name in SES (leave blank to use default pool)
CADENCE_SES_MANAGED_POOL_NAME=

# ARN of the SNS topic that receives SES event notifications (bounces, complaints, etc.)
CADENCE_SNS_TOPIC_ARN_SES_EVENTS=arn:aws:sns:us-east-1:123456789012:cadence-ses-events

# Verify SNS message signatures; set to false only in dev/testing
CADENCE_SNS_VERIFY_SIGNATURES=true

# ── OTTO integration ─────────────────────────────────────────────────────────────

# Endpoint Cadence POSTs to when a recipient unsubscribes (bidirectional sync)
CADENCE_OTTO_UNSUB_ENDPOINT=https://api.otto.example.com/cadence/unsub

# Bearer token for authenticating to the OTTO API
CADENCE_OTTO_API_KEY=changeme-otto-api-key  # SECRET — do not commit

# ── Rate limiting ────────────────────────────────────────────────────────────────

# Sustained send rate (messages/second); must not exceed your SES account limit
CADENCE_SEND_RATE_LIMIT_PER_SECOND=14

# Hard daily send cap — guard against runaway sends
CADENCE_SEND_DAILY_QUOTA=50000

# ── Workflow engine ───────────────────────────────────────────────────────────────

# How often the APScheduler workflow tick job runs (seconds)
CADENCE_WORKFLOW_TICK_INTERVAL_SECONDS=10

# ── AI (Anthropic) ───────────────────────────────────────────────────────────────

# Use "anthropic" in production; "mock" for local dev without real API calls
CADENCE_AI_BACKEND=anthropic

CADENCE_ANTHROPIC_API_KEY=sk-ant-changeme  # SECRET — do not commit

# Model used for email copy generation
CADENCE_ANTHROPIC_GENERATION_MODEL=claude-sonnet-4-5

# Model used for classification tasks
CADENCE_ANTHROPIC_CLASSIFICATION_MODEL=claude-haiku-4-5

# ── MAB / stats ──────────────────────────────────────────────────────────────────

# Minimum sends before a variant leaves the exploration phase
CADENCE_MAB_MIN_EXPLORE_SENDS=200

# Minimum sends before a variant can be retired
CADENCE_MAB_MIN_RETIRE_SENDS=1000

# How often to refresh the stats materialized view (seconds)
CADENCE_STATS_REFRESH_INTERVAL_SECONDS=300

# Google Postmaster Tools (v2) -- Gmail's reported spam rate.
# SES never sees a Gmail complaint, so this is the only source for the
# 0.1%/0.3% thresholds that decide Gmail deliverability. The service account
# must hold READER on the domain inside Postmaster Tools itself; a project-level
# grant alone returns an empty domain list.
# Unset = the sync no-ops.
CADENCE_POSTMASTER_CREDENTIALS_PATH=/opt/cadence/postmaster-sa.json  # SECRET -- do not commit the key
CADENCE_POSTMASTER_DOMAIN=domains/karzinsurance.com
# CADENCE_POSTMASTER_BACKEND=mock  # dev/test without a key
# CADENCE_POSTMASTER_LOOKBACK_DAYS=7
# CADENCE_POSTMASTER_SYNC_INTERVAL_SECONDS=21600
# Ratios, not percentages: 0.001 = 0.1% target, 0.003 = 0.3% hard ceiling.
# CADENCE_POSTMASTER_SPAM_RATE_WARN=0.001
# CADENCE_POSTMASTER_SPAM_RATE_CRITICAL=0.003
