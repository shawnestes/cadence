CADENCE_DATABASE_URL=postgresql+asyncpg://cadence:cadence@localhost:5432/cadence?ssl=require
CADENCE_LOG_LEVEL=INFO
CADENCE_ENVIRONMENT=dev
CADENCE_API_KEY=dev-api-key-change-me
CADENCE_OTTO_UNSUB_ENDPOINT=
CADENCE_OTTO_API_KEY=

# SES
CADENCE_ESP_BACKEND=noop
CADENCE_AWS_REGION=us-east-1
CADENCE_SES_CONFIGURATION_SET=
CADENCE_SES_SENDING_DOMAIN=
CADENCE_SES_FROM_ADDRESS=
CADENCE_SES_MANAGED_POOL_NAME=
CADENCE_SNS_TOPIC_ARN_SES_EVENTS=
CADENCE_SNS_VERIFY_SIGNATURES=false

# Unsub
CADENCE_UNSUB_SIGNING_KEY=dev-change-me-to-a-real-secret
CADENCE_UNSUB_BASE_URL=http://localhost:8000

# Rate limiting
CADENCE_SEND_RATE_LIMIT_PER_SECOND=14
CADENCE_SEND_DAILY_QUOTA=50000
